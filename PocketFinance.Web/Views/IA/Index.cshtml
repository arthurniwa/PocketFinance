@{ ViewData["Title"] = "Assistente IA"; }

<div class="page-header">
    <div>
        <h1 class="page-title">Assistente Financeiro</h1>
        <p class="page-subtitle">Pergunte sobre suas finanças</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="pf-card p-0" style="display: flex; flex-direction: column; height: 70vh;">

            <!-- Mensagens -->
            <div id="chat-messages" style="flex: 1; overflow-y: auto; padding: 1.25rem; display: flex; flex-direction: column; gap: 1rem;">
                <div class="chat-msg chat-msg-ia">
                    <div class="chat-bubble chat-bubble-ia">
                        Olá! Sou seu assistente financeiro. Posso te ajudar a entender seus gastos, receitas, metas e saldo. O que você quer saber?
                    </div>
                </div>
            </div>

            <!-- Input -->
            <div style="border-top: 1px solid var(--border); padding: 1rem; display: flex; gap: 0.75rem;">
                <input id="chat-input" type="text" class="pf-input" placeholder="Ex: Quanto gastei este mês?" style="flex: 1;" />
                <button id="chat-send" class="btn-pf btn-pf-primary" style="gap: 0.4rem;">
                    <i class="bi bi-send"></i> Enviar
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-msg { display: flex; }
    .chat-msg-ia { justify-content: flex-start; }
    .chat-msg-user { justify-content: flex-end; }

    .chat-bubble {
        max-width: 75%;
        padding: 0.625rem 0.875rem;
        border-radius: 12px;
        font-size: 0.875rem;
        line-height: 1.55;
        white-space: pre-wrap;
    }
    .chat-bubble-ia {
        background: var(--bg-2, #f1f5f9);
        color: var(--text-1);
        border-bottom-left-radius: 4px;
    }
    .chat-bubble-user {
        background: var(--primary);
        color: #fff;
        border-bottom-right-radius: 4px;
    }
    .chat-bubble-loading {
        background: var(--bg-2, #f1f5f9);
        color: var(--text-3);
        font-style: italic;
    }
</style>

@section Scripts {
<script>
(function () {
    const input    = document.getElementById('chat-input');
    const btn      = document.getElementById('chat-send');
    const messages = document.getElementById('chat-messages');
    const history  = [];

    function addMsg(role, text) {
        const div = document.createElement('div');
        div.className = `chat-msg chat-msg-${role === 'user' ? 'user' : 'ia'}`;
        const bubble = document.createElement('div');
        bubble.className = `chat-bubble ${role === 'user' ? 'chat-bubble-user' : 'chat-bubble-ia'}`;
        bubble.textContent = text;
        div.appendChild(bubble);
        messages.appendChild(div);
        messages.scrollTop = messages.scrollHeight;
        return bubble;
    }

    async function enviar() {
        const msg = input.value.trim();
        if (!msg) return;

        input.value = '';
        btn.disabled = true;
        addMsg('user', msg);

        const loading = addMsg('assistant', 'Analisando suas finanças...');
        loading.classList.add('chat-bubble-loading');

        try {
            const res = await fetch('/IA/Chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: msg, history })
            });
            const data = await res.json();
            const answer = data.answer || data.error || 'Erro inesperado.';

            loading.textContent = answer;
            loading.classList.remove('chat-bubble-loading');

            history.push({ role: 'user', content: msg });
            history.push({ role: 'assistant', content: answer });
        } catch {
            loading.textContent = 'Erro ao conectar com a IA.';
            loading.classList.remove('chat-bubble-loading');
        }

        btn.disabled = false;
        input.focus();
    }

    btn.addEventListener('click', enviar);
    input.addEventListener('keydown', e => { if (e.key === 'Enter') enviar(); });
})();
</script>
}