<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PocketFinance — @ViewData["Title"]</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        html, body { height: 100%; margin: 0; }
        body { display: flex; background: var(--bg-page); }

        .ext-panel-left {
            display: none;
            width: 420px;
            flex-shrink: 0;
            background: var(--primary, #1e293b);
            color: #fff;
            flex-direction: column;
            justify-content: space-between;
            padding: 2.5rem;
            min-height: 100vh;
        }
        @@media (min-width: 900px) { .ext-panel-left { display: flex; } }

        .ext-panel-right {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
            min-height: 100vh;
            overflow-y: auto;
        }

        .ext-brand {
            font-weight: 700;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #fff;
        }

        .ext-tagline {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .ext-feature {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            font-size: 0.875rem;
            color: rgba(255,255,255,0.75);
            margin-bottom: 0.875rem;
        }
        .ext-feature i { font-size: 1.1rem; color: rgba(255,255,255,0.5); }
    </style>
</head>
<body>
    <!-- Painel esquerdo (apenas desktop) -->
    <div class="ext-panel-left">
        <div class="ext-brand">
            <i class="bi bi-wallet2"></i> PocketFinance
        </div>
        <div class="ext-tagline">
            <h2 style="font-size: 1.75rem; font-weight: 700; line-height: 1.25; margin-bottom: 1rem;">
                Controle suas finanças com clareza
            </h2>
            <p style="font-size: 0.9rem; color: rgba(255,255,255,0.65); margin-bottom: 2rem; line-height: 1.6;">
                Registre, organize e acompanhe tudo que entra e sai do seu bolso.
            </p>
            <div>
                <div class="ext-feature"><i class="bi bi-bar-chart-line"></i> Resumo mensal com comparativos</div>
                <div class="ext-feature"><i class="bi bi-bullseye"></i> Metas financeiras com progresso</div>
                <div class="ext-feature"><i class="bi bi-bank"></i> Múltiplas contas bancárias</div>
                <div class="ext-feature"><i class="bi bi-robot"></i> Assistente financeiro com IA</div>
            </div>
        </div>
        <p style="font-size: 0.75rem; color: rgba(255,255,255,0.35);">© 2026 PocketFinance</p>
    </div>

    <!-- Painel direito com o formulário -->
    <div class="ext-panel-right">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
