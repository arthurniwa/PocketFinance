@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager

@{
    ViewData["Title"] = "Início";
    var logado = SignInManager.IsSignedIn(User);
    Layout = logado ? "/Views/Shared/_Layout.cshtml" : "/Views/Shared/_LayoutExterno.cshtml";
}

@if (logado)
{
    var cultura = new System.Globalization.CultureInfo("pt-BR");
    var nomeCompleto = User.Claims.FirstOrDefault(c => c.Type == "NomeCompleto")?.Value ?? User.Identity?.Name ?? "";
    var primeiroNome = nomeCompleto.Split(' ').FirstOrDefault() ?? "Olá";
    var saldoTotal   = ViewBag.SaldoTotal   != null ? (decimal)ViewBag.SaldoTotal   : 0m;
    var entradasMes  = ViewBag.EntradasMes  != null ? (decimal)ViewBag.EntradasMes  : 0m;
    var saidasMes    = ViewBag.SaidasMes    != null ? (decimal)ViewBag.SaidasMes    : 0m;
    var lancamentos  = ViewBag.UltimosLancamentos as List<PocketFinance.Core.Transacao> ?? new();
    var nomeMes      = DateTime.Now.ToString("MMMM", cultura);

    <div class="page-header">
        <div>
            <h1 class="page-title">Olá, @primeiroNome 👋</h1>
            <p class="page-subtitle">Resumo de @nomeMes</p>
        </div>
    </div>

    <!-- Cards de resumo -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="pf-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="pf-card-label">Saldo total</span>
                    <span class="pf-badge @(saldoTotal >= 0 ? "pf-badge-neutral" : "pf-badge-down")">
                        <i class="bi bi-wallet2"></i>
                    </span>
                </div>
                <span class="pf-card-value @(saldoTotal >= 0 ? "" : "text-danger")">
                    @saldoTotal.ToString("C", cultura)
                </span>
                <p class="text-muted-sm mt-2 mb-0">Todas as contas</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pf-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="pf-card-label">Receitas</span>
                    <span class="pf-badge pf-badge-up"><i class="bi bi-arrow-up"></i></span>
                </div>
                <span class="pf-card-value" style="color: #166534;">@entradasMes.ToString("C", cultura)</span>
                <p class="text-muted-sm mt-2 mb-0">Este mês</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="pf-card h-100">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="pf-card-label">Despesas</span>
                    <span class="pf-badge pf-badge-down"><i class="bi bi-arrow-down"></i></span>
                </div>
                <span class="pf-card-value" style="color: #991b1b;">@Math.Abs(saidasMes).ToString("C", cultura)</span>
                <p class="text-muted-sm mt-2 mb-0">Este mês</p>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <!-- Últimos lançamentos -->
        <div class="col-lg-8">
            <div class="pf-card p-0">
                <div class="d-flex justify-content-between align-items-center px-4 py-3" style="border-bottom: 1px solid var(--border);">
                    <span style="font-size: 0.875rem; font-weight: 600;">Últimos lançamentos</span>
                    <a asp-controller="Transacao" asp-action="Index" class="text-muted-sm" style="color: var(--text-3);">Ver todos</a>
                </div>
                @if (!lancamentos.Any())
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Nenhum lançamento ainda.<br>
                            <a asp-controller="Transacao" asp-action="Criar" style="color: var(--text-2);">Adicionar o primeiro</a>
                        </p>
                    </div>
                }
                else
                {
                    @foreach (var item in lancamentos)
                    {
                        var isReceita = item.Tipo == PocketFinance.Core.TipoTransacao.Receita;
                        <div class="pf-list-item">
                            <div class="d-flex align-items-center gap-3">
                                <div class="icon-circle @(isReceita ? "icon-up" : "icon-down")">
                                    <i class="bi @(isReceita ? "bi-arrow-up" : "bi-arrow-down")"></i>
                                </div>
                                <div>
                                    <div style="font-size: 0.875rem; font-weight: 500;">@item.Descricao</div>
                                    <div class="text-muted-sm">@item.Categoria · @item.Data.ToString("dd/MM/yyyy")</div>
                                </div>
                            </div>
                            <span style="font-size: 0.9375rem; font-weight: 600; color: @(isReceita ? "#166534" : "#991b1b");">
                                @(isReceita ? "+" : "")@item.Valor.ToString("C", cultura)
                            </span>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Acesso rápido -->
        <div class="col-lg-4">
            <div class="pf-card">
                <div style="font-size: 0.875rem; font-weight: 600; margin-bottom: 1rem;">Acesso rápido</div>
                <div class="d-flex flex-column gap-2">
                    <a asp-controller="Transacao" asp-action="Criar" class="btn-pf btn-pf-ghost w-100" style="justify-content: flex-start; gap: 0.5rem;">
                        <i class="bi bi-plus-circle"></i> Novo lançamento
                    </a>
                    <a asp-controller="Transacao" asp-action="Index" class="btn-pf btn-pf-ghost w-100" style="justify-content: flex-start; gap: 0.5rem;">
                        <i class="bi bi-cash-coin"></i> Ver Finanças
                    </a>
                    <a asp-controller="Meta" asp-action="Index" class="btn-pf btn-pf-ghost w-100" style="justify-content: flex-start; gap: 0.5rem;">
                        <i class="bi bi-bullseye"></i> Minhas Metas
                    </a>
                    <a asp-controller="CadastroConta" asp-action="Index" class="btn-pf btn-pf-ghost w-100" style="justify-content: flex-start; gap: 0.5rem;">
                        <i class="bi bi-bank"></i> Contas
                    </a>
                </div>
            </div>
        </div>
    </div>

    <style>
        .nav-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: border-color 0.15s, box-shadow 0.15s;
            cursor: pointer;
        }
        .nav-card:hover {
            border-color: #9ca3af;
            box-shadow: 0 1px 4px rgba(0,0,0,0.06);
        }
    </style>
}
else
{
    <div style="max-width: 900px; width: 100%; padding: 2rem 1rem;">
        <div class="row align-items-center g-5">
            <div class="col-lg-5">
                <p style="font-size: 0.8125rem; font-weight: 600; letter-spacing: 0.05em; color: #2563eb; text-transform: uppercase; margin-bottom: 1rem;">
                    Controle financeiro pessoal
                </p>
                <h1 style="font-size: 2.5rem; font-weight: 700; letter-spacing: -0.03em; line-height: 1.15; color: var(--text-1); margin-bottom: 1rem;">
                    Organize suas finanças com clareza
                </h1>
                <p style="font-size: 1rem; color: var(--text-2); line-height: 1.6; margin-bottom: 2rem;">
                    Registre receitas e despesas, acompanhe metas e visualize para onde vai o seu dinheiro.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-area="Identity" asp-page="/Account/Register" class="btn-pf btn-pf-primary" style="padding: 0.625rem 1.25rem; font-size: 0.9375rem;">
                        Criar conta grátis
                    </a>
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn-pf btn-pf-ghost" style="padding: 0.625rem 1.25rem; font-size: 0.9375rem;">
                        Entrar
                    </a>
                </div>
            </div>
            <div class="col-lg-7">
                <div class="pf-card p-0" style="overflow: hidden;">
                    <div style="background: var(--primary); padding: 1rem 1.25rem; display: flex; align-items: center; gap: 0.5rem;">
                        <div style="width:10px;height:10px;border-radius:50%;background:#ef4444;"></div>
                        <div style="width:10px;height:10px;border-radius:50%;background:#f59e0b;"></div>
                        <div style="width:10px;height:10px;border-radius:50%;background:#10b981;"></div>
                    </div>
                    <div style="padding: 1.5rem; background: #f9fafb;">
                        <div class="row g-2 mb-3">
                            <div class="col-4">
                                <div class="pf-card" style="padding: 0.875rem;">
                                    <div style="font-size: 0.75rem; color: var(--text-2); font-weight: 500;">Saldo</div>
                                    <div style="font-size: 1.125rem; font-weight: 700; margin-top: 0.25rem;">R$ 2.340</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="pf-card" style="padding: 0.875rem;">
                                    <div style="font-size: 0.75rem; color: #166534; font-weight: 500;">Receitas</div>
                                    <div style="font-size: 1.125rem; font-weight: 700; margin-top: 0.25rem; color: #166534;">R$ 5.000</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="pf-card" style="padding: 0.875rem;">
                                    <div style="font-size: 0.75rem; color: #991b1b; font-weight: 500;">Despesas</div>
                                    <div style="font-size: 1.125rem; font-weight: 700; margin-top: 0.25rem; color: #991b1b;">R$ 2.660</div>
                                </div>
                            </div>
                        </div>
                        <div class="pf-card p-0">
                            <div style="padding: 0.75rem 1rem; border-bottom: 1px solid var(--border); font-size: 0.8125rem; font-weight: 600;">Últimos lançamentos</div>
                            @foreach (var item in new[] {
                                new { Desc = "Salário", Cat = "Receita", Val = "+ R$ 5.000", Cor = "#166534" },
                                new { Desc = "Aluguel", Cat = "Moradia", Val = "- R$ 1.500", Cor = "#991b1b" },
                                new { Desc = "Mercado", Cat = "Alimentação", Val = "- R$ 380", Cor = "#991b1b" },
                                new { Desc = "Streaming", Cat = "Lazer", Val = "- R$ 55", Cor = "#991b1b" }
                            })
                            {
                                <div style="display:flex;justify-content:space-between;align-items:center;padding:0.625rem 1rem;border-bottom:1px solid var(--border);">
                                    <div>
                                        <div style="font-size:0.8125rem;font-weight:500;">@item.Desc</div>
                                        <div style="font-size:0.75rem;color:var(--text-3);">@item.Cat</div>
                                    </div>
                                    <span style="font-size:0.875rem;font-weight:600;color:@item.Cor;">@item.Val</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
