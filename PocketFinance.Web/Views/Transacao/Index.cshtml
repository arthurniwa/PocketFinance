@model IEnumerable<PocketFinance.Core.Transacao>
@using System.Text.Json
@{
    ViewData["Title"] = "Finanças";
    var cultura = new System.Globalization.CultureInfo("pt-BR");
    var labelsJson = JsonSerializer.Serialize(ViewBag.GraficoLabels as string[] ?? Array.Empty<string>());
    var valoresJson = JsonSerializer.Serialize(ViewBag.GraficoValores as decimal[] ?? Array.Empty<decimal>());
    var saldo = (decimal)ViewBag.Saldo;
    var entradas = (decimal)ViewBag.Entradas;
    var saidas = (decimal)ViewBag.Saidas;
    var mes = (int)ViewBag.Mes;
    var ano = (int)ViewBag.Ano;
    var dataMes = new DateTime(ano, mes, 1);
    var mesAnterior = dataMes.AddMonths(-1);
    var mesSeguinte = dataMes.AddMonths(1);
    var nomeMes = dataMes.ToString("MMMM yyyy", cultura);
    var entradasAnt = ViewBag.EntradasAnt != null ? (decimal)ViewBag.EntradasAnt : 0m;
    var saidasAnt = ViewBag.SaidasAnt != null ? (decimal)ViewBag.SaidasAnt : 0m;

    string ComparativoTexto(decimal atual, decimal anterior)
    {
        if(anterior == 0) return "Sem dados anteriores";

        var diff = ((atual - anterior) / Math.Abs(anterior)) * 100;
        var seta = diff >= 0 ? "↑" : "↓";

        return $"{seta} {Math.Abs(diff):0} % vs mês anterior";
    }

    string ComparativoCor(decimal atual, decimal anterior, bool inverter = false)
    {
        if(anterior == 0) return "var(--text-3)";
        
        var subiu = atual >= anterior;
        
        if(inverter) subiu = !subiu;

        return subiu ? "#166534" : "#991b1b";
    }
}

<div class="page-header">
    <div>
        <h1 class="page-title">Finanças</h1>
        <p class="page-subtitle">Movimentações de @nomeMes</p>
    </div>
    <a asp-action="Criar" class="btn-pf btn-pf-primary">
        <i class="bi bi-plus"></i> Novo lançamento
    </a>
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <a asp-action="Index"
       asp-route-contaId="@ViewBag.ContaId"
       asp-route-mes="@mesAnterior.Month"
       asp-route-ano="@mesAnterior.Year"
       class="btn-pf btn-pf-ghost btn-pf-sm">
        <i class="bi bi-chevron-left"></i>
    </a>
    <span style="font-size: 0.875rem; font-weight: 600; min-width: 130px; text-align: center; text-transform: capitalize;">
        @nomeMes
    </span>
    <a asp-action="Index"
       asp-route-contaId="@ViewBag.ContaId"
       asp-route-mes="@mesSeguinte.Month"
       asp-route-ano="@mesSeguinte.Year"
       class="btn-pf btn-pf-ghost btn-pf-sm">
        <i class="bi bi-chevron-right"></i>
    </a>
    @if (mes != DateTime.Now.Month || ano != DateTime.Now.Year)
    {
        <a asp-action="Index"
           asp-route-contaId="@ViewBag.ContaId"
           class="btn-pf btn-pf-ghost btn-pf-sm ms-1"
           title="Voltar ao mês atual">
            <i class="bi bi-calendar-check"></i> Hoje
        </a>
    }
</div>

<div class="d-flex gap-2 mb-4 flex-wrap">
    <a asp-action="Index"
       asp-route-mes="@mes"
       asp-route-ano="@ano"
       class="btn-pf @(ViewBag.ContaId == null ? "btn-pf-primary" : "btn-pf-ghost")">
        Todas
    </a>
    <a asp-action="Index" asp-route-contaId="-1"
       asp-route-mes="@mes"
       asp-route-ano="@ano"
       class="btn-pf @(ViewBag.ContaId == -1 ? "btn-pf-primary" : "btn-pf-ghost")">
        <i class="bi bi-question-circle"></i> Sem conta
    </a>
    @foreach (var conta in ViewBag.Contas as List<PocketFinance.Core.Conta>)
    {
        <a asp-action="Index" asp-route-contaId="@conta.Id"
           asp-route-mes="@mes"
           asp-route-ano="@ano"
           class="btn-pf @(ViewBag.ContaId == conta.Id ? "btn-pf-primary" : "btn-pf-ghost")">
            <i class="bi bi-bank"></i> @conta.Nome
        </a>
    }
</div>

<!-- Filtros -->
<div class="pf-card mb-4" style="padding: 0.875rem 1rem;">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <div style="position: relative;">
                <i class="bi bi-search" style="position: absolute; left: 0.75rem; top: 50%; transform: translateY(-50%); color: var(--text-3); font-size: 0.875rem;"></i>
                <input id="filtro-busca" type="text" class="pf-input" placeholder="Buscar por descrição..."
                       style="padding-left: 2.25rem;" />
            </div>
        </div>
        <div class="col-md-4">
            <select id="filtro-categoria" class="pf-input pf-select">
                <option value="">Todas as categorias</option>
            </select>
        </div>
        <div class="col-md-3">
            <div class="d-flex gap-1">
                <button class="btn-pf btn-pf-primary btn-pf-sm w-100 filtro-tipo" data-tipo="todos"
                        style="justify-content: center;">Todos</button>
                <button class="btn-pf btn-pf-ghost btn-pf-sm w-100 filtro-tipo" data-tipo="receita"
                        style="justify-content: center;">Receitas</button>
                <button class="btn-pf btn-pf-ghost btn-pf-sm w-100 filtro-tipo" data-tipo="despesa"
                        style="justify-content: center;">Despesas</button>
            </div>
        </div>
    </div>
</div>

<!-- Metric cards -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="pf-card h-100">
            <div class="d-flex justify-content-between align-items-start">
                <span class="pf-card-label">Saldo atual</span>
                <span class="pf-badge @(saldo >= 0 ? "pf-badge-neutral" : "pf-badge-down")">
                    <i class="bi @(saldo >= 0 ? "bi-wallet2" : "bi-exclamation-circle")"></i>
                </span>
            </div>
            <span class="pf-card-value @(saldo >= 0 ? "" : "text-danger")">@saldo.ToString("C", cultura)</span>
            <p class="text-muted-sm mt-2 mb-0">Saldo atual da conta</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="pf-card h-100">
            <div class="d-flex justify-content-between align-items-start">
                <span class="pf-card-label">Receitas do mês</span>
                <span class="pf-badge pf-badge-up"><i class="bi bi-arrow-up"></i></span>
            </div>
            <span class="pf-card-value" style="color: #166534;">@entradas.ToString("C", cultura)</span>
            <p class="mt-2 mb-0" style="font-size: 0.75rem; color: @ComparativoCor(entradas, entradasAnt);">
                @ComparativoTexto(entradas, entradasAnt)
            </p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="pf-card h-100">
            <div class="d-flex justify-content-between align-items-start">
                <span class="pf-card-label">Despesas do mês</span>
                <span class="pf-badge pf-badge-down"><i class="bi bi-arrow-down"></i></span>
            </div>
            <span class="pf-card-value" style="color: #991b1b;">@Math.Abs(saidas).ToString("C", cultura)</span>
           <p class="mt-2 mb-0" style="font-size: 0.75rem; color: @ComparativoCor(Math.Abs(saidas), Math.Abs(saidasAnt), inverter: true);">
                @ComparativoTexto(Math.Abs(saidas), Math.Abs(saidasAnt))
            </p>
    </div>
</div>

<div class="row g-3">
    <!-- Transaction list -->
    <div class="col-lg-7">
        <div class="pf-card p-0">
            <div class="d-flex justify-content-between align-items-center px-4 py-3" style="border-bottom: 1px solid var(--border);">
                <span style="font-size: 0.875rem; font-weight: 600;">Lançamentos</span>
                <span class="text-muted-sm">@Model.Count() registros</span>
            </div>

            @if (!Model.Any())
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>Nenhum lançamento ainda.<br><a asp-action="Criar" style="color: var(--text-2);">Adicionar o primeiro</a></p>
                </div>
            }
            else
            {
                @foreach (var item in Model)
                {
                    var isReceita = item.Tipo == PocketFinance.Core.TipoTransacao.Receita;
                    <div class="pf-list-item"
                         data-descricao="@item.Descricao.ToLower()"
                         data-categoria="@item.Categoria"
                         data-tipo="@(isReceita ? "receita" : "despesa")">
                        <div class="d-flex align-items-center gap-3">
                            <div class="icon-circle @(isReceita ? "icon-up" : "icon-down")">
                                <i class="bi @(isReceita ? "bi-arrow-up" : "bi-arrow-down")"></i>
                            </div>
                            <div>
                                <div style="font-size: 0.875rem; font-weight: 500;">@item.Descricao</div>
                                <div class="text-muted-sm">@item.Categoria · @item.Data.ToString("dd/MM/yyyy")</div>
                            </div>
                        </div>
                        <div class="d-flex align-items-center gap-3">
                            <span style="font-size: 0.9375rem; font-weight: 600; color: @(isReceita ? "#166534" : "#991b1b");">
                                @(isReceita ? "+" : "")@item.Valor.ToString("C", cultura)
                            </span>
                            <div class="pf-list-actions">
                                <a asp-action="Editar" asp-route-id="@item.Id" class="btn-pf btn-pf-ghost btn-pf-sm" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="Deletar" asp-route-id="@item.Id" method="post" style="display:inline;">
                                    <button type="submit" class="btn-pf btn-pf-danger btn-pf-sm" title="Excluir" onclick="return confirm('Excluir este lançamento?')">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Chart -->
    <div class="col-lg-5">
        <div class="pf-card h-100">
            <div style="font-size: 0.875rem; font-weight: 600; margin-bottom: 0.25rem;">Despesas por categoria</div>
            <p class="text-muted-sm mb-3">Distribuição do período</p>
            @if ((ViewBag.GraficoLabels as string[])?.Length > 0)
            {
                <div style="position: relative; max-height: 280px;">
                    <canvas id="graficoCategoria"></canvas>
                </div>
            }
            else
            {
                <div class="empty-state" style="padding: 2rem 1rem;">
                    <i class="bi bi-pie-chart" style="font-size: 1.75rem;"></i>
                    <p style="font-size: 0.8125rem;">Sem despesas para exibir</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const busca     = document.getElementById('filtro-busca');
    const catSelect = document.getElementById('filtro-categoria');
    const items     = document.querySelectorAll('.pf-list-item[data-descricao]');

    const cats = [...new Set([...items].map(i => i.dataset.categoria).filter(Boolean))].sort();
    cats.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c;
        opt.textContent = c;
        catSelect.appendChild(opt);
    });

    let tipoAtivo = 'todos';

    function filtrar() {
        const texto = busca.value.toLowerCase().trim();
        const cat   = catSelect.value;
        let visiveis = 0;

        items.forEach(item => {
            const matchTexto = !texto || item.dataset.descricao.includes(texto);
            const matchCat   = !cat   || item.dataset.categoria === cat;
            const matchTipo  = tipoAtivo === 'todos' || item.dataset.tipo === tipoAtivo;
            const visivel    = matchTexto && matchCat && matchTipo;
            item.style.display = visivel ? '' : 'none';
            if (visivel) visiveis++;
        });

        const contador = document.querySelector('.pf-card .text-muted-sm');
        if (contador) contador.textContent = visiveis + ' registros';
    }

    busca.addEventListener('input', filtrar);
    catSelect.addEventListener('change', filtrar);

    document.querySelectorAll('.filtro-tipo').forEach(btn => {
        btn.addEventListener('click', () => {
            tipoAtivo = btn.dataset.tipo;
            document.querySelectorAll('.filtro-tipo').forEach(b => {
                b.classList.remove('btn-pf-primary');
                b.classList.add('btn-pf-ghost');
            });
            btn.classList.remove('btn-pf-ghost');
            btn.classList.add('btn-pf-primary');
            filtrar();
        });
    });
})();
</script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    (function () {
        var canvas = document.getElementById('graficoCategoria');
        if (!canvas) return;

        var cores = ['#1e293b','#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#06b6d4','#f97316','#ec4899'];

        new Chart(canvas.getContext('2d'), {
            type: 'doughnut',
            data: {
                labels: @Html.Raw(labelsJson),
                datasets: [{
                    data: @Html.Raw(valoresJson),
                    backgroundColor: cores,
                    borderWidth: 0,
                    hoverOffset: 6
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { font: { size: 11, family: 'Inter' }, usePointStyle: true, padding: 12 }
                    }
                }
            }
        });
    })();
</script>
}
